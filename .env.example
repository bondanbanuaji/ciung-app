# Database PostgreSQL — pakai SUPABASE (pooler untuk runtime/serverless).
# Ambil di: Supabase Dashboard → Project Settings → Database → Connection string → URI (port 6543, mode Transaction).
# Contoh: postgresql://postgres.xxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Koneksi langsung (session pooler, port 5432) — khusus `prisma migrate`.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST].pooler.supabase.com:5432/postgres"

# Rahasia untuk menandatangani cookie sesi JWT. Generate: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
